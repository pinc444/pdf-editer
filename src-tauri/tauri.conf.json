{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PDF Editor MVP",
  "version": "0.1.0",
  "identifier": "com.pinc444.pdfeditor",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420"
  },
  "app": {
    "windows": [
      {
        "title": "PDF Editor MVP",
        "width": 1400,
        "height": 900,
        "resizable": true
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "windows": {
      "wix": {
        "language": "en-US"
      }
    }
  }
}
